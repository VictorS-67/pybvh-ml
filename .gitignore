# Internal-only development history; the public record is CHANGELOG.md
# (see the "Release records" section in CLAUDE.md).
docs/internal_logs/

# Generated from gallery/feature_gallery.ipynb by scripts/export_gallery.py;
# never edit by hand.
docs/gallery/

# gallery/*.gif are regenerated by executing the gallery notebook but are
# COMMITTED, not ignored (same convention as pybvh): the notebook displays
# them via raw.githubusercontent URLs because GitHub's notebook renderer
# drops image/gif outputs, so an ignored GIF would 404 there.

# Integration tests run against internal datasets that are not shared.
# Keep the test code itself out of the public repo too.
tests/integration/

# Machine-local symlinks to licensed corpora the integration tests read.
internal_data/
